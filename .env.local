# Base URL of the Mohandes Man API (include /api/v1, no trailing slash).
# Example: https://test.kbdcland.ir/api/v1
NEXT_PUBLIC_API_BASE_URL=https://test.kbdcland.ir/api/v1

# Optional media origin for relative upload paths. Defaults to {apiOrigin}/public
# NEXT_PUBLIC_MEDIA_BASE_URL=https://test.kbdcland.ir/public

# Test host certificate does not match test.kbdcland.ir (ERR_TLS_CERT_ALTNAME_INVALID).
# Required for server-side fetch and next/image against this environment.
# Never enable against a production host with a valid certificate.
API_TLS_INSECURE=true
NODE_TLS_REJECT_UNAUTHORIZED=0

# Catalog/content mocks are retired for domains with live APIs.
# Keep true only for local fixture review of account/engineer overlays.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Development-only mock engineer auth. Ignored in production builds.
NEXT_PUBLIC_ENABLE_MOCK_REGISTER=true
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=true

# Development-only mock customer auth. Ignored in production builds.
NEXT_PUBLIC_ENABLE_MOCK_USER_REGISTER=true
NEXT_PUBLIC_ENABLE_MOCK_USER_LOGIN=true
