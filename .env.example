# Base URL of the Mohandes Man API (include /api/v1, no trailing slash).
# Example: https://test.kbdcland.ir/api/v1
# Do not commit real credentials or environment-specific secrets.
NEXT_PUBLIC_API_BASE_URL=

# Optional TLS server name for an API host whose certificate uses another valid
# name. This is scoped to the configured API origin and keeps verification on.
API_TLS_SERVERNAME=

# Optional absolute media base for relative upload paths (defaults to {apiOrigin}/public).
# NEXT_PUBLIC_MEDIA_BASE_URL=

# Live-first: when NEXT_PUBLIC_API_BASE_URL is set, the app uses live APIs.
# Mock overlays and mock auth are opt-in only when the API base URL is empty.
NEXT_PUBLIC_USE_MOCK_DATA=false

# Development-only mock engineer auth. Ignored in production builds.
# Primary toggles live in config/mock-auth.config/mock-auth.config.ts
NEXT_PUBLIC_ENABLE_MOCK_REGISTER=false
NEXT_PUBLIC_ENABLE_MOCK_LOGIN=false

# Development-only mock customer auth. Ignored in production builds.
NEXT_PUBLIC_ENABLE_MOCK_USER_REGISTER=false
NEXT_PUBLIC_ENABLE_MOCK_USER_LOGIN=false
